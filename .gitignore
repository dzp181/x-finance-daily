# 全局 gitignore 会忽略 README.md，这里显式取消
!README.md

.DS_Store
__pycache__/
*.pyc
.build/

# 抓取缓存可重建，不进仓库
data/raw/
data/tweets.jsonl
data/watchlist.json

# 渲染中间件
episodes/*/build/
episodes/*/.cache/

# 数字人依赖：体积大且有独立许可，不进仓库
.venv-lipsync/
assets/models/
scripts/lipsync/third_party/

# 成片体积大
episodes/*/avatar/*.mp4
episodes/*/avatar/*.wav

# 背景原图可重新生成，只保留处理后的成品
assets/bg/src/

# 同一期的分支版本（本地对比用）
episodes/*/video-frost.mp4
episodes/*/video-beam.mp4
episodes/*/cover-frost.png
episodes/*/cover-beam.png

# ima 打包产物（可重建）
outbox/

# social-auto-upload 运行环境（体积大，可重建）
vendor/social-auto-upload/
.venv-sau/
.browsers/
